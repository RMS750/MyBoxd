# Backend
ENVIRONMENT=development
DATABASE_URL=sqlite:///./myboxd.db
TMDB_API_KEY=
FRONTEND_URL=http://localhost:5173
SESSION_DAYS=30
MAX_UPLOAD_MB=25
TMDB_ENRICH_LIMIT=120
CANDIDATE_ENRICH_LIMIT=96
# Development convenience only. Set false in production and run Alembic migrations.
AUTO_CREATE_SCHEMA=true

# Frontend (put this in frontend/.env.local when running separately)
VITE_API_URL=http://localhost:8000/api
